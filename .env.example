# --- Django ---
DJANGO_SECRET_KEY=change-me
# Fernet key for encrypting OAuth tokens. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Public hostname used by Caddy for HTTPS in production
DOMAIN=localhost
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use local SQLite (db.sqlite3)
DATABASE_URL=postgres://shipmatch:shipmatch@db:5432/shipmatch
# Production (docker-compose.prod.yml): password of the Postgres container, used when it is first created
POSTGRES_PASSWORD=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
# 1 = run tasks inline (no Redis needed). Use 0 in Docker/production.
CELERY_TASK_ALWAYS_EAGER=0

# --- File storage (empty = local media/ folder) ---
S3_BUCKET=shipmatch
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- OCR for scanned PDFs ---
# auto = Claude reads scans when EXTRACTION_PROVIDER=anthropic; text = text layer only;
# anthropic = always Claude; textract = AWS Textract
OCR_PROVIDER=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- LLM extraction ---
# rules = offline regex extractor (no key needed); anthropic or openai = LLM
EXTRACTION_PROVIDER=rules
# Empty = claude-sonnet-5-5 (anthropic). Cheaper: claude-haiku-4-5
LLM_MODEL=
# What the AI reads: auto = the PDF itself only for scans; pdf = always the PDF too; text = text only
LLM_INPUT=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Intake: accepted files and safety limits ---
# Accepted: PDF, JPG, PNG, TIFF, WebP, XLSX, CSV and ZIP archives of those. Photos and spreadsheets get a
# PDF copy (the original is kept for download). Sizes in MB.
INTAKE_MAX_FILE_MB=25
INTAKE_MAX_ARCHIVE_MB=100
# ZIP archives: files inside (nested archives included), total unpacked size, the most one file may be
# compressed (unpacked / packed; higher looks like a zip bomb) and how deep archives inside archives are opened.
INTAKE_ZIP_MAX_FILES=200
INTAKE_ZIP_MAX_TOTAL_MB=300
INTAKE_ZIP_MAX_RATIO=100
INTAKE_ZIP_MAX_DEPTH=1
# Images: largest photo accepted, and the most pages of one multi-page TIFF
INTAKE_MAX_IMAGE_MEGAPIXELS=120
INTAKE_MAX_IMAGE_PAGES=50
INTAKE_MAX_IMAGE_TOTAL_MEGAPIXELS=500
# Spreadsheets: rows read per sheet and columns read per row
INTAKE_SHEET_MAX_ROWS=5000
INTAKE_SHEET_MAX_COLUMNS=60
# 1 = split a PDF that holds several invoices into one document per invoice
INTAKE_SPLIT_PDFS=1
# 1 = with AI reading on, one small AI call checks uncertain page boundaries before splitting
INTAKE_SPLIT_AI_CONFIRM=1

# --- Gmail ingestion ---
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_LABEL=AP-Inbox

# --- Email intake (Settings > Email intake; see README "Email intake") ---
# Forwarding addresses <org-slug>-<token>@INBOUND_EMAIL_DOMAIN. Empty = off. The domain's MX points at
# Postmark (webhook /inbound/email/postmark/) or Mailgun (route to /inbound/email/mailgun/).
INBOUND_EMAIL_DOMAIN=
# Postmark inbound webhook: https://USER:PASSWORD@your-host/inbound/email/postmark/
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=
# Mailgun HTTP webhook signing key (verifies each route request)
MAILGUN_SIGNING_KEY=
# Largest webhook request (MB) and emails per organization per minute
INBOUND_EMAIL_MAX_MB=40
INBOUND_EMAIL_RATE_PER_MINUTE=60
# Microsoft 365 / Outlook.com mailboxes (Azure app registration; delegated Graph permissions
# offline_access, User.Read, Mail.ReadWrite)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# Defaults to SITE_URL + /settings/email/microsoft/callback; set it only if the provider must call back elsewhere.
# MS_REDIRECT_URI=http://localhost:8000/settings/email/microsoft/callback
# How often Microsoft 365, IMAP and Gmail mailboxes are checked
MAILBOX_POLL_MINUTES=5
# 1 = allow IMAP servers on private networks (10.x, 192.168.x, localhost); testing only
MAILBOX_ALLOW_PRIVATE_HOSTS=0

# --- QuickBooks Online ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# Defaults to SITE_URL + /accounting/qbo/callback; set it only if the provider must call back elsewhere.
# QBO_REDIRECT_URI=http://localhost:8000/accounting/qbo/callback
QBO_MINOR_VERSION=75

# --- Xero (an organization connects QuickBooks or Xero; see README "Xero") ---
# From the app at developer.xero.com. A "Web app" has a client secret; leave XERO_CLIENT_SECRET empty
# for a "PKCE" app (ShipMatch then signs in with PKCE).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Defaults to SITE_URL + /accounting/xero/callback; set it only if the provider must call back elsewhere.
# XERO_REDIRECT_URI=http://localhost:8000/accounting/xero/callback
# Apps created from 2 March 2026 need granular scopes instead of accounting.transactions:
# XERO_SCOPES=offline_access accounting.invoices accounting.payments.read accounting.contacts accounting.settings accounting.attachments
XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.settings accounting.attachments

# --- Payment status of posted bills (QuickBooks and Xero) ---
# Celery beat reads each organization's unpaid bills at most once per PAYMENT_SYNC_HOURS (minimum 1)
PAYMENT_SYNC_ENABLED=1
PAYMENT_SYNC_HOURS=1

# Fields below this confidence go to review
REVIEW_CONFIDENCE_THRESHOLD=0.85

# --- Rates and savings ---
# Default tolerance for organizations that haven't set their own (Rates > Checking rules):
# an overcharge is flagged when it is more than this percentage of the quoted amount and more
# than this fixed amount in the home currency.
RATE_TOLERANCE_PERCENT=2
RATE_TOLERANCE_AMOUNT=10
# 1 = let the AI name invoice charges the keyword table doesn't know (only with an LLM provider)
RATE_AI_CLASSIFY=1
LOG_LEVEL=INFO

# --- Customs entries and free time (apps/customs) ---
# Alert this many days before a container's last free day (organizations can change it in Settings > Customs)
CUSTOMS_LFD_ALERT_DAYS=2
# Local hour (each organization's time zone) from which the day's last free day alerts are sent
CUSTOMS_ALERT_HOUR=7
# Differences up to this amount (entry currency) between printed and recalculated duty, fees and totals are rounding
CUSTOMS_DUTY_TOLERANCE=1.00
# Entered value may differ from the commercial invoices by this percentage before it is flagged
CUSTOMS_VALUE_TOLERANCE_PERCENT=1.0
# MPF minimum/maximum rows added to (or replacing) the dated table in apps/customs/fees.py, as JSON. Use it when
# CBP publishes a new fiscal year before a ShipMatch release has it. `manage.py check` reports a broken value.
# Example: CUSTOMS_MPF_TABLE=[{"from": "2027-10-01", "min": "35.50", "max": "690.00", "source": "92 FR ..."}]
CUSTOMS_MPF_TABLE=
# Harbor Maintenance Fee in percent; empty = 0.125
CUSTOMS_HMF_RATE=
# 1 = with AI reading on, ask once per tariff number and description whether they fit (a warning, never an error)
CUSTOMS_AI_HTS_CHECK=1

# --- Cache (login lockout, rate limits, 2FA replay protection) ---
# Empty = in-process memory (fine for one process). Use Redis when running several web processes.
CACHE_URL=redis://redis:6379/1

# --- Sessions and sign-in ---
# Absolute session length, and sign-out after this long without activity (0 = off)
SESSION_MAX_HOURS=10
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=25
LOGIN_LOCKOUT_MINUTES=15

# --- Email (invites and password resets). Empty EMAIL_HOST prints emails to the console. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=ShipMatch <no-reply@example.com>
# Public address of ShipMatch, used for links in alerts (Slack, Teams, email) and for the Microsoft,
# QuickBooks and Xero redirect URIs unless they are set above. No trailing slash.
SITE_URL=http://localhost:8000

# --- Proxy and logging ---
# 1 only when a trusted reverse proxy (Caddy, nginx, load balancer) sets X-Forwarded-For
TRUST_X_FORWARDED_FOR=0
# json = one JSON object per line (for log shippers); plain = readable text
LOG_FORMAT=plain
API_RATE_LIMIT_PER_MINUTE=120

# --- Vendor learning: remember how each vendor prints values reviewers corrected ---
VENDOR_LEARNING=1
# Hard cap (characters) on the vendor notes added to the AI reader's prompt
LEARNING_HINT_MAX_CHARS=1200
# 0-100: how closely the top of a document must match a known vendor's name
LEARNING_MATCH_SCORE=90

# --- Public "Try it on your invoice" page at /try/ (no sign-in) ---
TRY_ENABLED=0
TRY_MAX_MB=10
TRY_MAX_PAGES=10
# Per visitor IP; counted in the cache (use Redis via CACHE_URL when running several web processes)
TRY_RATE_PER_HOUR=5
TRY_RATE_PER_DAY=20
# All visitors together per day (UTC); bounds AI cost
TRY_DAILY_LIMIT=200
# Uploads and results are deleted after this many hours (purge_try, hourly in Celery beat)
TRY_RETENTION_HOURS=24
# "Talk to us" button on the try page, e.g. https://cal.com/your-name or mailto:sales@example.com
DEMO_CONTACT_URL=

# --- Demo mode: banner, demo accounts on the sign-in page, guard rails, nightly reset ---
DEMO_MODE=0
# Organizations reset_demo deletes and rebuilds every night (comma separated)
DEMO_ORGS=demo
# UTC hour of the nightly reset
DEMO_RESET_HOUR=3
# Public demos never send email or Slack/Teams alerts. 1 = allow (private demos only).
DEMO_SEND_OUTSIDE=0

# --- Landed cost and shared invoices ---
# How charges are spread over a shipment's products until an admin chooses (value, quantity, weight or volume)
LANDED_DEFAULT_METHOD=value
# Suggest a split when one freight invoice names several shipments (a reviewer confirms it). 0 = off
SHARED_INVOICE_DETECT=1
# --- Month-end close (apps/close): defaults for organizations without their own Month-end settings ---
CLOSE_ACCRUED_LIABILITIES_ACCOUNT=Accrued liabilities
# Debited when a vendor has no account of its own (freight, and supplier invoices for goods)
CLOSE_FREIGHT_ACCOUNT=Freight expense
CLOSE_GOODS_ACCOUNT=Inventory
# Shipments that shipped longer ago than this before the period end are listed, not accrued
CLOSE_LOOKBACK_DAYS=180
# Past invoices needed before a vendor's or the organization's median is used as an estimate
CLOSE_MIN_HISTORY=3
# Lines read from one vendor statement
CLOSE_STATEMENT_MAX_LINES=2000
# How many days of QuickBooks bill payments "Read payments from QuickBooks" reads
CLOSE_PAYMENT_SYNC_DAYS=180
# --- Team workflow and firm view (apps.workflow) ---
# Hours an approval link in a "ready for approval" alert names its shipment (it never signs anyone in)
APPROVAL_LINK_MAX_AGE_HOURS=72
# Minutes after posting during which authors may edit or delete their own comment
COMMENT_EDIT_MINUTES=15
# Most shipments one bulk action (approve, assign, post) may cover
BULK_MAX_SHIPMENTS=100
# 1 = admins of an organization may create new client organizations from the All clients page
FIRM_CAN_CREATE_ORGS=0
# --- Self-serve signup at /signup/ (needs working email: EMAIL_HOST) ---
SIGNUP_ENABLED=0
# Hours the emailed confirmation link works
SIGNUP_VERIFY_HOURS=48
# Sign-up attempts per visitor network
SIGNUP_RATE_PER_HOUR=5
SIGNUP_RATE_PER_DAY=20
# Refuse throwaway email domains (short built-in list); add more, comma separated
SIGNUP_BLOCK_DISPOSABLE=1
SIGNUP_BLOCKED_DOMAINS=

# --- Billing with Stripe (Settings > Billing). 0 = no plans, limits or Stripe calls ---
BILLING_ENABLED=0
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint https://<host>/billing/stripe/webhook/ (comma separated while rolling)
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
# Monthly price ids of the three plans (Stripe: Products > price > API ID)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Shown price and monthly documents per plan
BILLING_STARTER_PRICE=199
BILLING_STARTER_DOCUMENTS=300
BILLING_GROWTH_PRICE=499
BILLING_GROWTH_DOCUMENTS=1000
BILLING_SCALE_PRICE=1290
BILLING_SCALE_DOCUMENTS=4000
BILLING_CURRENCY=USD
# Free trial for new sign-ups: days, which plan's users and features, how many documents
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=growth
BILLING_TRIAL_DOCUMENTS=100
# New uploads and emails stop at this percentage of the plan's monthly documents (review and posting never stop)
BILLING_HARD_LIMIT_PERCENT=120
STRIPE_API_BASE=https://api.stripe.com
STRIPE_API_VERSION=2024-06-20

# --- Outgoing webhooks (Settings > Webhooks) and exports ---
WEBHOOK_MAX_ATTEMPTS=8
# Failed attempts in a row before an endpoint is turned off (admins are emailed)
WEBHOOK_DISABLE_AFTER_FAILURES=20
WEBHOOK_TIMEOUT_SECONDS=10
# After "New secret", events are also signed with the old secret for this many hours
WEBHOOK_SECRET_OVERLAP_HOURS=24
EXPORT_XLSX_MAX_ROWS=200000
